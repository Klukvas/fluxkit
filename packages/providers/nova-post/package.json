{
  "name": "@fluxkit/provider-nova-post",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Nova Post shipping provider (new REST API v.1.0, JWT): city and branch/parcel-locker lookups, estimate, waybills, find-back, cancel, tracking, labels.",
  "fluxkit": {
    "provider": "nova_post",
    "kind": "shipping"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fluxkit/core": "workspace:*",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/testing": "12.2.0",
    "@swc/core": "1.16.18",
    "@types/node": "26.6.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
