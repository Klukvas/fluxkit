{
  "name": "@fluxkit/provider-fake",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Test-only fake shipping provider. Deterministic, in-memory, no network. Fixture for the provider enable/disable/delete CI matrix and for tests of the shipping module.",
  "fluxkit": {
    "provider": "fake",
    "kind": "shipping"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fluxkit/core": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/testing": "12.2.0",
    "@swc/core": "1.16.18",
    "@types/node": "26.6.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
