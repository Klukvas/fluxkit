{
  "name": "@fluxkit/provider-brevo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Brevo email provider: sends one transactional mail per call through POST https://api.brevo.com/v3/smtp/email with the outbox message id as the idempotency key.",
  "fluxkit": {
    "provider": "brevo",
    "kind": "email",
    "secrets": [
      {
        "field": "api_key",
        "purpose": "outbound",
        "env": "BREVO_API_KEY"
      },
      {
        "field": "webhook_secret",
        "purpose": "webhook",
        "env": "BREVO_WEBHOOK_SECRET"
      }
    ]
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fluxkit/core": "workspace:*",
    "@nestjs/common": "12.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/platform-express": "12.5.0",
    "@nestjs/testing": "12.5.0",
    "@swc/core": "1.16.20",
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
