{
  "name": "@fluxkit/provider-liqpay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "LiqPay (PrivatBank) payment provider: form checkout handoff, status reads, refunds and SHA3-256-signed urlencoded webhooks through https://www.liqpay.ua with the shop's public and private keys.",
  "fluxkit": {
    "provider": "liqpay",
    "kind": "payment",
    "secrets": [
      {
        "field": "public_key",
        "purpose": "outbound",
        "env": "LIQPAY_PUBLIC_KEY"
      },
      {
        "field": "private_key",
        "purpose": "outbound",
        "env": "LIQPAY_PRIVATE_KEY"
      }
    ]
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fluxkit/core": "workspace:*",
    "@nestjs/common": "12.4.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/testing": "12.4.2",
    "@swc/core": "1.16.20",
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}