{
  "name": "@fluxkit/api-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "API building blocks a feature package may use: problems, admin permissions and DI tokens (ADR 0049).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fluxkit/core": "workspace:*",
    "@nestjs/common": "12.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@swc/core": "1.16.20",
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    }
  }
}
