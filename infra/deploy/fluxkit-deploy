#!/bin/bash
# Deploys one Fluxkit release from the image registry on this host (docs/deployment.md, "Automatic deployment").
#
# Called by .github/workflows/deploy.yml over SSH. The workflow's key is limited to this script in authorized_keys:
#   command="/usr/local/sbin/fluxkit-deploy",restrict ssh-ed25519 AAAA... fluxkit-deploy
# The client's command line is "deploy <commit sha>"; stdin carries the release's infra/ directory as a tar stream
# (git archive --format=tar <sha> infra). By hand, as root: fluxkit-deploy deploy <sha> < infra.tar
#
# Order: lock, check for an executable backup command, unpack, pull every image, back up, switch FLUXKIT_IMAGE_TAG and
# /opt/fluxkit/current, infrastructure, migrate, roll api then storefront, edge. When the new release does not become healthy, the previous one is started again; that
# cannot undo a migration the new release ran (the old API refuses a newer database: restore the backup).
# FLUXKIT_DEPLOY_ALLOW_NO_BACKUP=1 allows a deploy without a backup command on a throwaway host.
#
# Optional features (docs/deployment.md, "Optional features"): to switch one on, add its name to FEATURES_ENABLED in the env
# file, then deploy; the start below runs `migrate` (same env file, so the feature's migrations too) before the API, which
# refuses to start while an enabled feature's migrations are missing. A failed feature migration fails the release like any
# migration; the env file restored for the previous release is the one edited before this run (the feature still on), so
# remove the name by hand if the previous release cannot start either. Switching one off is removing the name and deploying;
# its tables stay. Removing its data means running its .down.sql by hand before any core down (docs/deployment.md); this
# script never runs a down migration.
set -euo pipefail

FLUXKIT_ROOT=${FLUXKIT_ROOT:-/opt/fluxkit}
ENV_FILE=${FLUXKIT_ENV_FILE:-/etc/fluxkit/production.env}
MEILI_ENV_FILE=${FLUXKIT_MEILI_ENV_FILE:-/etc/fluxkit/meilisearch.env}
BACKUP_COMMAND=${FLUXKIT_DEPLOY_BACKUP:-/usr/local/sbin/fluxkit-backup}
PRUNE_COMMAND=${FLUXKIT_DEPLOY_PRUNE:-/usr/local/sbin/fluxkit-prune-images}
LOCK_FILE=${FLUXKIT_DEPLOY_LOCK:-/run/lock/fluxkit-deploy.lock}
# Test-only: FLUXKIT_DEPLOY_SKIP_PULL=1 uses locally built/tagged smoke images. Never set on the host.
WAIT_SECONDS=300
MIGRATE_WAIT_SECONDS=600

log() { echo "fluxkit deploy: $*"; }
fail() { echo "fluxkit deploy: $*" >&2; exit 1; }

release_digest() {
  # Hash ordered file contents, not paths: rollback restores the exact .pre-deploy bytes. Never print env contents.
  local file
  for file in "$1/infra/docker-compose.prod.yml" "$ENV_FILE" "$MEILI_ENV_FILE"; do
    sha256sum < "$file" || return 1
  done | sha256sum | cut -d ' ' -f 1
}

check_backup_command() {
  # The check and the call must name the same file: a relative name would be checked here and looked up in PATH later.
  case "$BACKUP_COMMAND" in
    /*) ;;
    *) fail "FLUXKIT_DEPLOY_BACKUP must be an absolute path, got $BACKUP_COMMAND" ;;
  esac
  if [ -f "$BACKUP_COMMAND" ] && [ -x "$BACKUP_COMMAND" ]; then
    backup_enabled=true
  elif [ "${FLUXKIT_DEPLOY_ALLOW_NO_BACKUP:-0}" = 1 ]; then
    log "WARNING: no executable backup command at $BACKUP_COMMAND. Deploying without a backup (FLUXKIT_DEPLOY_ALLOW_NO_BACKUP=1)." >&2
    backup_enabled=false
  else
    fail "no executable backup command at $BACKUP_COMMAND. Install it or set FLUXKIT_DEPLOY_ALLOW_NO_BACKUP=1 on a throwaway host."
  fi
}

compose() {
  local release_dir=$1
  shift
  local digest
  digest=$(release_digest "$release_dir") || return 1
  set -- docker compose --env-file "$ENV_FILE" -f "$release_dir/infra/docker-compose.prod.yml" "$@"
  if [ -n "${COMPOSE_TIMEOUT_SECONDS:-}" ]; then
    set -- timeout --kill-after=10s "$COMPOSE_TIMEOUT_SECONDS" "$@"
  fi
  FLUXKIT_RELEASE_DIGEST="$digest" FLUXKIT_ENV_FILE="$ENV_FILE" FLUXKIT_MEILI_ENV_FILE="$MEILI_ENV_FILE" "$@"
}

env_value() { sed -n "s/^$1=//p" "$ENV_FILE"; }

replica_count() {
  local value
  value=$(env_value "$1")
  value=${value:-1}
  [[ "$value" =~ ^[1-9][0-9]*$ ]] || fail "$1 must be a positive integer in $ENV_FILE"
  echo "$value"
}

remove_replicas() {
  local id
  for id in $1; do
    docker stop "$id" >/dev/null || return 1
    docker rm "$id" >/dev/null || return 1
    # One disappearing address at a time, on success and on failure, while both edges refresh Docker DNS.
    sleep 11
  done
}

wait_healthy() {
  local ids=$1 deadline=$((SECONDS + WAIT_SECONDS)) id state pending
  while true; do
    pending=false
    for id in $ids; do
      state=$(docker inspect -f '{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{end}}' "$id") || return 1
      case "$state" in
        "running healthy") ;;
        "running starting"|"created "*) pending=true ;;
        *) log "replica $id failed health: $state"; return 1 ;;
      esac
    done
    [ "$pending" = true ] || return 0
    [ "$SECONDS" -lt "$deadline" ] || { log "replicas did not become healthy within ${WAIT_SECONDS}s"; return 1; }
    sleep 1
  done
}

roll_service() {
  local release=$1 service=$2 count=$3 old_ids='' old_count=0 expected_digest id actual_digest running
  local unchanged=true new_ids='' all_ids start_ok step new_count
  all_ids=$(compose "$release" ps -a -q "$service" | tr '\n' ' ') || return 1
  for id in $all_ids; do
    running=$(docker inspect -f '{{.State.Running}}' "$id") || return 1
    if [ "$running" = true ]; then
      old_ids="$old_ids $id"
    else
      # A stopped container serves nothing; leaving it lets Compose restart it instead of creating a replacement.
      log "$service: removing non-running container $id before staging"
      docker rm "$id" >/dev/null || return 1
    fi
  done
  # A release from before this script wrote the label (its Compose file does not declare it) creates containers with an
  # empty label: expect that, so a rollback to it keeps its untouched replicas and accepts its replacements.
  if grep -q 'com.fluxkit.release-digest' "$release/infra/docker-compose.prod.yml"; then
    expected_digest=$(release_digest "$release") || return 1
    [ -n "$expected_digest" ] || return 1
  else
    expected_digest=''
  fi
  for id in $old_ids; do
    old_count=$((old_count + 1))
    actual_digest=$(docker inspect -f '{{index .Config.Labels "com.fluxkit.release-digest"}}' "$id") || return 1
    [ "$actual_digest" = "$expected_digest" ] || unchanged=false
  done
  if [ "$unchanged" = true ] && [ "$old_count" -eq "$count" ]; then
    log "$service: $count replicas already use this release digest"
    return 0
  fi

  # Docker DNS publishes starting containers too. Admit at most one unready address at a time so two edge tries suffice.
  for ((step = 1; step <= count; step++)); do
    log "$service: starting replacement $step/$count alongside $old_count old replicas"
    start_ok=true
    compose "$release" up -d --no-build --no-deps --no-recreate --scale "$service=$((old_count + step))" "$service" || start_ok=false
    all_ids=$(compose "$release" ps -a -q "$service" | tr '\n' ' ') || return 1
    new_count=0
    for id in $all_ids; do
      case " $old_ids " in
        *" $id "*) ;;
        *)
          new_count=$((new_count + 1))
          case " $new_ids " in
            *" $id "*) ;;
            # Newest first: if this stage fails, withdraw its unready address before healthy staged replicas.
            *) new_ids="$id $new_ids" ;;
          esac
          actual_digest=$(docker inspect -f '{{index .Config.Labels "com.fluxkit.release-digest"}}' "$id") || start_ok=false
          if [ "$actual_digest" != "$expected_digest" ]; then
            log "$service: replacement $id has the wrong release digest"
            start_ok=false
          fi
          ;;
      esac
    done
    if [ "$start_ok" != true ] || [ "$new_count" -ne "$step" ] || ! wait_healthy "$new_ids"; then
      log "$service: replacements failed; removing only the new replicas, keeping the old ones"
      remove_replicas "$new_ids" || return 1
      return 1
    fi
  done
  # nginx caches Docker DNS for 10 seconds (Caddy refreshes sooner). Discover new addresses before removing any old one.
  log "$service: replacements healthy; waiting for edge DNS refresh"
  sleep 11
  log "$service: draining and removing $old_count old replicas"
  remove_replicas "$old_ids" || return 1
  log "$service: $count replacements serving"
}

start_release() {
  local release=$1 api_count=$2 storefront_count=$3 migrate_status=0
  log "starting infrastructure"
  compose "$release" up -d --wait --wait-timeout "$WAIT_SECONDS" --no-build postgres meilisearch redis || return 1
  log "running migrations to completion"
  # Foreground completion, including the exit code: an unhealthy or failed migration never starts new API replicas.
  COMPOSE_TIMEOUT_SECONDS="$MIGRATE_WAIT_SECONDS" compose "$release" up --no-build --no-deps --force-recreate --exit-code-from migrate migrate || migrate_status=$?
  if [ "$migrate_status" -ne 0 ]; then
    if [ "$migrate_status" -eq 124 ] || [ "$migrate_status" -eq 137 ]; then
      log "migrations exceeded ${MIGRATE_WAIT_SECONDS}s; killing and removing migrate"
      # Postgres rolls back an interrupted migration transaction; a non-transactional migration file needs the backup.
      compose "$release" kill migrate || true
      compose "$release" rm -f migrate || true
    fi
    return 1
  fi
  roll_service "$release" api "$api_count" || return 1
  roll_service "$release" storefront "$storefront_count" || return 1
  log "starting edge and remaining services"
  # Application configuration already matches. Compose restarts the exited migrate container (nothing pending), then edge/rest.
  compose "$release" up -d --wait --wait-timeout "$WAIT_SECONDS" --no-build || return 1
}

# Under the forced command the client's words arrive in SSH_ORIGINAL_COMMAND; by hand they are the arguments.
read -r action tag extra <<< "${SSH_ORIGINAL_COMMAND:-$*}" || true
if [ "${action:-}" != deploy ] || ! [[ "${tag:-}" =~ ^[0-9a-f]{7,40}$ ]] || [ -n "${extra:-}" ]; then
  fail "usage: deploy <commit sha, 7 to 40 lowercase hex characters>"
fi
tag=${tag:0:7}

exec 9> "$LOCK_FILE"
flock -n 9 || fail "another deployment is running"
check_backup_command

[ -n "$(env_value FLUXKIT_IMAGE_PREFIX)" ] || fail "set FLUXKIT_IMAGE_PREFIX (registry repository prefix) in $ENV_FILE"
api_replicas=$(replica_count FLUXKIT_API_REPLICAS)
storefront_replicas=$(replica_count FLUXKIT_STOREFRONT_REPLICAS)
if [ "$api_replicas" -gt 1 ] && [ "$(env_value RATE_LIMIT_STORE)" != redis ]; then
  fail "more than one api replica requires RATE_LIMIT_STORE=redis in $ENV_FILE"
fi
previous_tag=$(env_value FLUXKIT_IMAGE_TAG)
[ -n "$previous_tag" ] || fail "FLUXKIT_IMAGE_TAG missing in $ENV_FILE"
previous_release=$(readlink -f "$FLUXKIT_ROOT/current") || fail "$FLUXKIT_ROOT/current is missing"

release_dir="$FLUXKIT_ROOT/releases/$tag"
staging=$(mktemp -d "$FLUXKIT_ROOT/releases/.incoming-XXXXXX")
trap 'rm -rf "$staging"' EXIT
tar -x --no-same-owner --no-same-permissions -C "$staging" -f - infra
[ -f "$staging/infra/docker-compose.prod.yml" ] || fail "the release archive has no infra/docker-compose.prod.yml"
if [ -d "$release_dir" ]; then
  log "release directory $release_dir exists: kept (same commit, same files)"
else
  chmod 755 "$staging"
  mv "$staging" "$release_dir"
fi

log "release $tag (running: $previous_tag)"
if [ "${FLUXKIT_DEPLOY_SKIP_PULL:-0}" = 1 ]; then
  log "test-only: registry pull skipped"
else
  log "pulling release images"
  FLUXKIT_IMAGE_TAG=$tag compose "$release_dir" pull --quiet
fi

if [ "$backup_enabled" = true ]; then
  log "backup before the switch"
  "$BACKUP_COMMAND"
fi

cp -p "$ENV_FILE" "$ENV_FILE.pre-deploy"
sed -i "s/^FLUXKIT_IMAGE_TAG=.*/FLUXKIT_IMAGE_TAG=$tag/" "$ENV_FILE"
ln -sfn "$release_dir" "$FLUXKIT_ROOT/current"

if start_release "$release_dir" "$api_replicas" "$storefront_replicas"; then
  log "release $tag is up"
  if [ -x "$PRUNE_COMMAND" ]; then
    "$PRUNE_COMMAND" || log "warning: image cleanup failed; the release runs (run $PRUNE_COMMAND by hand)"
  fi
  exit 0
fi

log "release $tag did not become healthy; starting $previous_tag again" >&2
compose "$release_dir" logs --tail 50 migrate api >&2 || true
cp -p "$ENV_FILE.pre-deploy" "$ENV_FILE"
ln -sfn "$previous_release" "$FLUXKIT_ROOT/current"
# Roll back through the same release-digest check, recomputed with the byte-identical restored .pre-deploy env file.
# Unchanged old replicas are never recreated. If an earlier service already
# rolled successfully, replace it with healthy previous-release replicas before draining it. Migrations cannot be undone.
start_release "$previous_release" "$api_replicas" "$storefront_replicas" ||
  fail "the previous release $previous_tag did not start either; if $tag ran a migration, restore the backup (docs/deployment.md, \"Updates and migrations\")"
fail "release $tag failed; $previous_tag runs again"
