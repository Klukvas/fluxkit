# Template of infra/production.env for infra/docker-compose.prod.yml (docs/deployment.md). Copy it, fill it in, keep the
# copy out of git (it is git-ignored) and readable by the deploy user only (chmod 600). Every variable is explained in
# the root .env.example and docs/contracts/config.md; this file lists what a production deployment sets.
# The file is used twice: Compose reads it for ${...} in the Compose file (--env-file), and the api and migrate
# containers receive all of it as their environment. The storefront and the edge receive only their own variables.

# --- Host and TLS (Compose and the edge) ---
# The shop host name, lower case. The storefront, the admin (/admin-ui), the API routes and /media are all served on it.
FLUXKIT_DOMAIN=shop.example.com
# Directory on the host with fullchain.pem and privkey.pem (readable by uid 101, the edge's nginx user).
FLUXKIT_CERTS_DIR=/etc/fluxkit/certs
# Image names: <prefix>-api, <prefix>-storefront, <prefix>-edge, tag below (set the tag per release, e.g. a git SHA).
# FLUXKIT_IMAGE_PREFIX=fluxkit
# FLUXKIT_IMAGE_TAG=latest
# Published ports of the edge (defaults 80 and 443).
# FLUXKIT_HTTP_PORT=80
# FLUXKIT_HTTPS_PORT=443

# --- PostgreSQL (the postgres container; the API's DATABASE_URL is built from these in the Compose file) ---
POSTGRES_USER=fluxkit
# SECRET. Hex only, so it can stand unescaped in a URL: openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DB=fluxkit

# --- API: required ---
# SECRET. At least 32 characters: openssl rand -base64 48. Changing it invalidates the links of unpaid guest orders and
# every emailed reset or verification link (ADR 0023, ADR 0031). Back it up with the database.
ORDER_TOKEN_SECRET=
# Proxies between the internet and the API that set X-Forwarded-For: 1 = the edge alone; 2 = a CDN in front of the edge.
TRUST_PROXY=1

# --- Storefront and admin images: image hosts ---
# Host names product images may come from (https only), comma-separated. Also the build argument of the storefront image
# (its CSP is frozen at build time) and the admin CSP img-src at the edge: rebuild the storefront after a change.
# Uploaded images are served from FLUXKIT_DOMAIN/media, so FLUXKIT_DOMAIN belongs here as soon as uploads are used.
STOREFRONT_IMAGE_HOSTS=shop.example.com

# --- Storefront: client address for the search window (ADR 0037) ---
# true: the storefront passes the edge's X-Forwarded-For on to the API, so the search results page counts each shopper. Right
# for this Compose file: the storefront publishes no port and the edge sets the header on every path (one snippet,
# infra/proxy/nginx/snippets/forwarded-headers.conf). Never true for a storefront reachable around the edge. Unset is false.
STOREFRONT_FORWARD_CLIENT_ADDRESS=true

# --- API: shop settings (defaults shown; see .env.example) ---
# SHOP_CURRENCY=UAH
# PRICES_INCLUDE_TAX=true
# LOW_STOCK_THRESHOLD=5
# DEFAULT_LOCALE=uk
# LOCALES=uk,en
# FEATURES_ENABLED=
# ADMIN_COOKIE_SECURE=true
# STORE_COOKIE_SECURE=true
# ADMIN_SESSION_IDLE_MINUTES=720
# ADMIN_SESSION_MAX_HOURS=168
# CUSTOMER_SESSION_IDLE_MINUTES=43200
# CUSTOMER_SESSION_MAX_HOURS=2160
# CART_TTL_DAYS=30
# ORDER_PAYMENT_TTL_MINUTES=30
# ORDER_GUEST_ACCESS_DAYS=90
# MAX_OPEN_ORDERS=3
# SCHEDULER_ENABLED=true
# SCHEDULER_INTERVAL_SECONDS=60
# MEDIA_MAX_BYTES=10485760
# MEDIA_MAX_PIXELS=50000000

# --- API: providers (each optional; the test-only fakes are refused in production) ---
# Shipping: nova_post needs NOVA_POST_API_KEY (SECRET) and NOVA_POST_ENVIRONMENT=production for real waybills.
# SHIPPING_PROVIDERS_ENABLED=
# NOVA_POST_API_KEY=
# NOVA_POST_ENVIRONMENT=sandbox
# Payments: monobank needs MONOBANK_TOKEN (SECRET) and SHOP_CURRENCY=UAH; the edge routes /webhooks/payments/monobank.
# PAYMENT_PROVIDERS_ENABLED=
# MONOBANK_TOKEN=
# Email: resend needs RESEND_API_KEY (SECRET) and EMAIL_FROM.
# EMAIL_PROVIDER=none
# EMAIL_FROM=
# EMAIL_REPLY_TO=
# RESEND_API_KEY=
