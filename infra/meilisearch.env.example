# Template of infra/meilisearch.env, read only by the meilisearch container of infra/docker-compose.prod.yml
# (docs/deployment.md, "Catalog search"). Copy it, fill it in, chmod 600; the copy is git-ignored.
# SECRET, at least 16 bytes: openssl rand -hex 32. Used once to create the API's scoped key; the API never receives it.
MEILI_MASTER_KEY=
