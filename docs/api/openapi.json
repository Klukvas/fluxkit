          "401": {
            "description": "Authentication required.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDoc"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error. Details are only in the server log.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDoc"
                }
              }
