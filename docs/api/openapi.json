  "info": {
    "title": "Fluxkit API",
    "description": "",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "FieldErrorDoc": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "example": "name.uk"
          },
          "code": {
            "type": "string",
            "example": "required"
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["path", "code"]
      },
      "ProblemDetailsDoc": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "about:blank"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "number"
          },
          "code": {
            "type": "string",
            "enum": [
              "validation_failed",
              "unauthorized",
              "not_found",
              "conflict",
              "in_use",
              "invalid_transition",
              "rule_violation",
              "internal_error"
            ]
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldErrorDoc"
            }
          },
          "field": {
            "type": "string",
            "description": "Request field that caused a conflict, when known."
          },
          "constraint": {
            "type": "string",
            "description": "Database constraint name of a conflict or in-use problem."
          },
          "rule": {
            "type": "string",
            "description": "Core rule code of a rule_violation or invalid_transition."
          }
        },
        "required": ["type", "title", "status", "code", "detail"]
      }
    }
  }
