    "/admin/brands": {
      "post": {
        "operationId": "BrandsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    },
                    "description": "Translated text: locale code to text. The default locale is required for required texts."
                  },
                  "description": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    },
                    "description": "Translated text: locale code to text. The default locale is required for required texts."
                  },
                  "logoUrl": {
                    "type": "string",
                    "maxLength": 2048,
                    "format": "uri",
                    "pattern": "^https?://"
                  },
                  "slug": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                    "maxLength": 160
                  }
                },
                "required": ["name"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created brand. `Location` points to it.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "slug": {
                      "type": "string"
                    },
                    "name": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      },
                      "description": "Translated text: locale code to text. The default locale is required for required texts."
