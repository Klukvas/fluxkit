                        "type": "string"
                      },
                      "description": "Translated text: locale code to text. The default locale is required for required texts."
                    },
                    "logoUrl": {
                      "nullable": true,
                      "type": "string"
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time",
                      "description": "ISO 8601, UTC."
                    },
                    "updatedAt": {
                      "type": "string",
                      "format": "date-time",
                      "description": "ISO 8601, UTC."
                    }
                  },
                  "required": [
                    "id",
                    "slug",
                    "name",
                    "description",
                    "logoUrl",
                    "createdAt",
                    "updatedAt"
                  ],
                  "additionalProperties": false
                }
              }
            }
