{
  "name": "@fluxkit/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "openapi:export": "node dist/openapi-export.js",
    "db:generate": "drizzle-kit generate",
    "db:drift": "bash ../../scripts/check-schema-drift.sh",
    "start": "node --env-file=../../.env dist/main.js",
    "db:migrate": "node --env-file=../../.env dist/database/migrate.js",
    "seed": "node --env-file=../../.env dist/seed/seed.js",
    "admin:create": "node --env-file=../../.env dist/auth/create-admin.js",
    "admin:unlock": "node --env-file=../../.env dist/auth/unlock-admin.js",
    "jobs:run-once": "node --env-file=../../.env dist/jobs/run-once.js"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@swc/core": "1.16.18",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@fluxkit/config": "workspace:*",
    "@fluxkit/core": "workspace:*",
    "@fluxkit/seeds": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "bullmq": "6.3.15",
    "drizzle-orm": "0.45.4",
    "ioredis": "6.0.0",
    "meilisearch": "0.62.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  }
}
