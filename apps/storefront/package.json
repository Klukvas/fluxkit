{
  "name": "@fluxkit/storefront",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 node --env-file-if-exists=../../.env node_modules/next/dist/bin/next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 node --env-file-if-exists=../../.env node_modules/next/dist/bin/next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "@fluxkit/config": "workspace:*",
    "@fluxkit/theme": "workspace:*",
    "@fluxkit/ui": "workspace:*",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
