# Copy to .env and fill in. Never commit .env.
# Variables are added here together with the code that reads them (see AGENTS.md section 3).
# The values below are placeholders for local development only. Use strong unique secrets elsewhere.

# --- infra/docker-compose.yml ---
POSTGRES_USER=fluxkit
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=fluxkit_dev
POSTGRES_PORT=5432

REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379

# Meilisearch requires a master key of at least 16 bytes in production mode.
MEILI_ENV=development
MEILI_MASTER_KEY=change-me-meili-master-key
MEILI_PORT=7700
# Used by the search spike test (apps/api). Must match MEILI_PORT and MEILI_MASTER_KEY above.
MEILI_URL=http://127.0.0.1:7700

# --- apps/api ---
# Local development values matching infra/docker-compose.yml (adjust to your .env).
# Tests drop schema objects and refuse any database whose name does not end in _test:
# for `pnpm test` create a separate database (e.g. fluxkit_test) and export its URL as DATABASE_URL.
DATABASE_URL=postgres://fluxkit:change-me-postgres@127.0.0.1:5432/fluxkit_dev
REDIS_URL=redis://:change-me-redis@127.0.0.1:6379
PORT=3000
# Comma-separated optional features to enable, e.g. FEATURES_ENABLED=example
FEATURES_ENABLED=
# Override the feature packages directory (defaults to <repo>/packages/features).
# FEATURES_DIR=
# Comma-separated shipping provider codes to load from packages/providers (ADR 0029), e.g. fake (test-only: refused when
# NODE_ENV=production) or nova_post (packages/providers/nova-post). Empty loads none.
SHIPPING_PROVIDERS_ENABLED=
# Nova Post (only read when SHIPPING_PROVIDERS_ENABLED contains nova_post; packages/providers/nova-post/README.md).
# NOVA_POST_API_KEY: the API key from the business cabinet (new.novaposhta.ua, Settings - Security). A secret: never commit
# it, never put it in the admin settings. Required when nova_post is enabled (the API refuses to start without it).
# NOVA_POST_API_KEY=
# NOVA_POST_ENVIRONMENT: sandbox (default) or production; production only when written here.
# NOVA_POST_ENVIRONMENT=sandbox
# Online payments (ADR 0032, docs/contracts/config.md). PAYMENT_PROVIDERS_ENABLED: comma-separated provider codes to load from
# packages/providers; empty (default) means no online payment and orders are paid by hand as before. Written exactly: lowercase
# letters, digits and underscores, an empty entry, a wrong spelling or a repeated code stops the startup. fake is test-only (it
# charges nothing) and is refused when NODE_ENV=production; monobank is accepted here, its plugin arrives with payments plan step 7
# (it will read MONOBANK_TOKEN itself). With a provider enabled ORDER_PAYMENT_TTL_MINUTES must be at least 8, and in production
# STOREFRONT_PUBLIC_URL is required and must be https (the return and webhook addresses are built from it).
PAYMENT_PROVIDERS_ENABLED=
# Transactional email (ADR 0031, docs/contracts/config.md). EMAIL_PROVIDER: none (default: no mail is sent, no provider package is
# read), resend or fake. fake is test-only (it delivers nothing) and is refused when NODE_ENV=production. Anything else stops the startup.
EMAIL_PROVIDER=none
# EMAIL_FROM: the sender, `Display Name <local@domain>` or a bare address; the display name is the shop name in mail. Required
# when EMAIL_PROVIDER is not none. EMAIL_REPLY_TO: optional, one mailbox. Both are checked at startup whenever they are set.
EMAIL_FROM=
# EMAIL_REPLY_TO=
# Only read with EMAIL_PROVIDER=resend (packages/providers/resend/README.md): the Resend API key, re_ followed by 16 to 256
# visible ASCII characters; a sending-only key is enough. A secret: never commit it. Required with resend (the API refuses
# to start without it).
# RESEND_API_KEY=
# Only read with EMAIL_PROVIDER=fake (packages/providers/_fake-email/README.md): an absolute path of a JSON Lines file the fake
# appends every accepted mail to (end-to-end tests).
# FAKE_EMAIL_CAPTURE_FILE=
# The API also reads STOREFRONT_PUBLIC_URL (set below for the storefront): the only base of links in mail. With an email provider in
# production it is required and must be https.
# Locale every translated text must contain, and the locales accepted in translated texts (comma-separated,
# the default must be in the list). Lowercase codes such as uk, en, en-us.
DEFAULT_LOCALE=uk
LOCALES=uk,en
# Admin sessions (docs/contracts/config.md). ADMIN_COOKIE_SECURE adds the Secure flag to the session cookie: keep true
# whenever the API is served over HTTPS; set false only for local plain-HTTP development. Only true or false are accepted.
ADMIN_COOKIE_SECURE=true
# Close a session after this many idle minutes, and after this many hours in total (whichever comes first).
ADMIN_SESSION_IDLE_MINUTES=720
ADMIN_SESSION_MAX_HOURS=168
# Customer sessions (docs/contracts/config.md). STORE_COOKIE_SECURE is the Secure flag of the customer session cookie:
# keep true whenever the API is served over HTTPS; set false only for local plain-HTTP development. Only true or false
# are accepted. Independent of the admin settings above. Idle limit in minutes (30 days) and total lifetime in hours (90 days).
STORE_COOKIE_SECURE=true
CUSTOMER_SESSION_IDLE_MINUTES=43200
CUSTOMER_SESSION_MAX_HOURS=2160
# Carts (docs/contracts/config.md). A cart expires this many days after its last change (whole number, 1 to 365); the
# guest cart cookie `fluxkit_cart` lives as long. Its Secure flag follows STORE_COOKIE_SECURE above.
CART_TTL_DAYS=30
# Orders (docs/contracts/config.md). An order waits this many minutes for payment (whole number, 5 to 1440) before it expires
# and gives its reserved stock back. A guest can open their order with its access token for this many days (1 to 3650).
ORDER_PAYMENT_TTL_MINUTES=30
ORDER_GUEST_ACCESS_DAYS=90
# Guest order access tokens (docs/contracts/config.md, ADR 0023). ORDER_TOKEN_SECRET is the key the API derives the access token of
# a guest order from (HMAC-SHA256 over the order id and the checkout's Idempotency-Key), so a repeated checkout request gets the
# SAME token. At least 32 characters, no default: the API refuses to start without it (and every command that reads this file
# refuses when NODE_ENV=production). Generate one with `openssl rand -base64 48` and keep it secret. The value below is a
# placeholder for local development only. Changing it later makes the tokens of existing unpaid guest orders stop working
# (docs/adr/0023-deterministic-guest-order-tokens.md).
ORDER_TOKEN_SECRET=change-me-order-token-secret-at-least-32-chars
# Open orders (docs/contracts/config.md, ADR 0024). A customer, or a guest email, may hold this many unpaid orders at once (whole
# number, 1 to 50); the next checkout is refused with 409 too_many_open_orders until one is paid, cancelled or expired. It stops one
# shopper from holding the stock with orders nobody pays. The limit counts an email or a customer, not an IP address.
MAX_OPEN_ORDERS=3
# Reverse proxy (docs/contracts/config.md, README Deployment notes). TRUST_PROXY is the number of proxies between the internet and
# the API (whole number, 0 to 10) that put the real client address into X-Forwarded-For, for example 1 for a single Next.js server or
# nginx in front. 0 trusts none: the client is the connecting address and X-Forwarded-For is ignored. The rate limits of the store
# and the admin login count per client address, so set the EXACT hop count: too high and a client can invent its address and
# dodge the limits, too low and all shoppers share the proxy's address and one window.
TRUST_PROXY=0
# Scheduler (docs/api/jobs.md). Expires unpaid orders (gives their stock back), sweeps stale reservations, delivers domain events
# and deletes expired carts and customer sessions, every SCHEDULER_INTERVAL_SECONDS (whole number, 10 to 3600) in this process,
# under a Postgres lock so that only one API instance works per tick. SCHEDULER_ENABLED accepts only true or false; with false
# run `pnpm jobs:run-once` from a cron instead, or unpaid orders keep their stock reserved.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
# Pricing (docs/contracts/config.md). SHOP_CURRENCY is the one currency the shop sells in: every active variant needs a
# price in it before its product can be published. Upper-case ISO 4217 code, exactly as listed there (UAH, USD, EUR, PLN,
# GBP, CZK, CHF, CAD, JPY, KWD); anything else fails startup. PRICES_INCLUDE_TAX is only a flag for the storefront (no tax
# is calculated); only true or false are accepted. LOW_STOCK_THRESHOLD: "low stock" starts at this many units or fewer
# (whole number, 0 or more).
SHOP_CURRENCY=UAH
PRICES_INCLUDE_TAX=true
LOW_STOCK_THRESHOLD=5
# Media uploads (docs/contracts/config.md, ADR 0028). MEDIA_STORAGE_DRIVER is `local` (images are stored in MEDIA_DIR) or `none` (uploads
# off, images are entered as URLs only); anything else fails startup. Outside production it defaults to local; in production it must be
# set. MEDIA_DIR is an absolute path; outside production it defaults to <repo>/var/media (git-ignored), in production it is required with
# local and must be a persistent volume that is backed up together with Postgres. MEDIA_PUBLIC_BASE_URL is the URL prefix of every
# stored image (an absolute http or https URL, no trailing slash, query, fragment or credentials, in normalized form); outside
# production it defaults to http://127.0.0.1:<PORT>/media, in production it is required with local and must be https. Changing it
# later does NOT rewrite stored URLs. MEDIA_MAX_BYTES (1024 to 52428800) and MEDIA_MAX_PIXELS (1 to 100000000) are whole numbers,
# digits only. The lines below show the defaults outside production, so they stay commented out.
# Do NOT switch to `none` once uploads exist: `none` answers 404 for every uploaded image URL (products, brand logos, order history),
# and after switching back to `local` the cleanup job deletes every never-attached upload older than 24 h. Keep `local` while uploads
# exist and never use `none` as a temporary switch. With `none`, MEDIA_PUBLIC_BASE_URL still names the prefix attach marking checks
# (default outside production; in production keep the old value set).
# Attach marking recognises ONLY this exact prefix: a URL of the same file with another scheme or host spelling (www, http,
# an alias or CDN host) is saved as a foreign URL, stays unattached and its file is deleted after 24 h. The admin always uses
# the URL the upload returned.
# MEDIA_STORAGE_DRIVER=local
# MEDIA_DIR=/absolute/path/to/media
# MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:3000/media
# MEDIA_MAX_BYTES=10485760
# MEDIA_MAX_PIXELS=50000000
# Read ONLY by `pnpm admin:create` (the first owner's password). Leave it commented out: pass it in the shell for that one command
# (`ADMIN_PASSWORD=... pnpm admin:create --email you@example.com`) so a password never sits in .env (docs/contracts/config.md).
# ADMIN_PASSWORD=
# --- apps/storefront (docs/contracts/config.md; read by `next dev` and `next start`, not by the API) ---
# API_INTERNAL_URL: where the Next server reaches the API (http or https origin, no path). In `next dev` it is also the target of the
# /store/* rewrite, which exists for development only: a deployed environment routes /store/* to the API with a reverse proxy
# (ADR 0026). Required for `next dev` and `next start`; the default API port is 3000.
API_INTERNAL_URL=http://127.0.0.1:3000
# STOREFRONT_PUBLIC_URL: the public origin for canonical URLs, hreflang, sitemap and JSON-LD. Required when NODE_ENV=production;
# otherwise defaults to http://localhost:3001.
STOREFRONT_PUBLIC_URL=http://localhost:3001
# STOREFRONT_IMAGE_HOSTS: comma-separated host names (no scheme, port, path or wildcard) allowed for product images, for example
# cdn.example.com,images.example.org. Empty means none (every image shows the placeholder). Read at `next build` (CSP headers) and
# again at `next start` (image optimizer and pages): set the same value for both; changing the CSP part needs a rebuild.
STOREFRONT_IMAGE_HOSTS=
# --- apps/storefront/e2e (Playwright, `pnpm test:e2e`; read by the e2e suite only, not by the API or the storefront; apps/storefront/e2e/README.md) ---
# E2E_DATABASE_URL: a database WIPED at every run; its name must end in _e2e_test (the suite refuses any other). Not DATABASE_URL, on purpose.
# The suite also needs REDIS_URL, MEILI_URL and MEILI_MASTER_KEY (set above or in the shell) and never reads this file: export the variables.
# E2E_DATABASE_URL=postgres://fluxkit:change-me-postgres@127.0.0.1:5432/fluxkit_e2e_test
# Optional ports of the three servers it starts (defaults 3102 proxy, 3100 API, 3101 storefront).
# E2E_PORT=3102
# E2E_API_PORT=3100
# E2E_STOREFRONT_PORT=3101
# Both suites start their API with MEDIA_STORAGE_DRIVER=local on a temp directory (under the system temp directory, removed after the
# run) and MEDIA_PUBLIC_BASE_URL on the proxy origin; they set every MEDIA_* variable themselves, so the ones above are ignored there.
# --- apps/admin/e2e (Playwright, `pnpm test:e2e` runs it after the storefront suite; read by the e2e suite only; apps/admin/e2e/README.md) ---
# It uses the same E2E_DATABASE_URL, REDIS_URL, MEILI_URL and MEILI_MASTER_KEY as above. Optional ports of the two servers it starts:
# ADMIN_E2E_PORT is the proxy (the only origin the browser sees, default 3112), ADMIN_E2E_API_PORT the API behind it (default 3110).
# ADMIN_E2E_PORT=3112
# ADMIN_E2E_API_PORT=3110
# --- apps/admin (development only; `vite build` never reads it) ---
# ADMIN_DEV_API_URL: where `vite dev` and `vite preview` of the admin proxy /admin/* and /media/* (an http or https origin, no path). Optional,
# default http://127.0.0.1:3000; a malformed value stops the dev server. apps/admin/README.md.
# ADMIN_DEV_API_URL=http://127.0.0.1:3000
