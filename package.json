{
  "name": "fluxkit",
  "version": "0.0.0",
  "private": true,
  "description": "Fluxkit: white-label e-commerce template. Powered by FluxLab.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10.28.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test": "pnpm build && turbo run test",
    "test:e2e": "pnpm build && pnpm --filter @fluxkit/storefront test:e2e && pnpm --filter @fluxkit/admin test:e2e",
    "db:migrate": "pnpm build && pnpm --filter @fluxkit/api db:migrate",
    "seed": "pnpm build && pnpm --filter @fluxkit/api seed",
    "admin:create": "pnpm build && pnpm --filter @fluxkit/api admin:create",
    "admin:unlock": "pnpm build && pnpm --filter @fluxkit/api admin:unlock",
    "jobs:run-once": "pnpm build && pnpm --filter @fluxkit/api jobs:run-once",
    "openapi:export": "pnpm --filter @fluxkit/api build && pnpm --filter @fluxkit/api openapi:export",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:docs": "node scripts/check-docs.mjs --base origin/main",
    "notices": "node scripts/third-party-notices.mjs",
    "feature-matrix": "bash scripts/feature-matrix.sh",
    "audit:prod": "pnpm audit --prod --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "dependency-cruiser": "18.6.0",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
