{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@fluxkit/storefront#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/generate-feature-registry.mjs"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["STOREFRONT_IMAGE_HOSTS", "STOREFRONT_REQUIRE_LEGAL_TEXT"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "@fluxkit/storefront#typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/generate-feature-registry.mjs"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "REDIS_URL", "MEILI_URL", "MEILI_MASTER_KEY"]
    },
    "@fluxkit/admin#test": {
      "dependsOn": ["^build", "build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "REDIS_URL", "MEILI_URL", "MEILI_MASTER_KEY"]
    }
  }
}
